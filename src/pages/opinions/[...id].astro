---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const opinions = await getCollection(
    'entries',
    ({ data }) => data.section === 'opinion' && !data.draft,
  );

  return opinions.map((opinion) => ({
    params: { id: opinion.id },
    props: { opinion },
  }));
}

interface Props {
  opinion: CollectionEntry<'entries'>;
}

const { opinion } = Astro.props;
const { Content } = await render(opinion);
---

<EntryLayout entry={opinion}>
  <Content />
</EntryLayout>
