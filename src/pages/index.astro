  <section class="principles" aria-labelledby="principles-title">
    <p class="section-number">001 / Working principles</p>
    <h2 id="principles-title">From source to structure,<br />with the reasoning left in.</h2>
    <div class="principle-grid">
      <article>
        <span>01</span>
        <h3>Real evidence</h3>
        <p>Chromatograms, spectra, calculations, and source records accompany interpretation whenever publication rights allow.</p>
      </article>
      <article>
        <span>02</span>
        <h3>Auditable reasoning</h3>
        <p>Observations, inference, uncertainty, and corrections remain visible instead of disappearing behind a final claim.</p>
      </article>
      <article>
        <span>03</span>
        <h3>Open participation</h3>
        <p>Researchers can propose topics, report corrections, and contribute articles through GitHub.</p>
      </article>
    </div>
  </section>
</BaseLayout>