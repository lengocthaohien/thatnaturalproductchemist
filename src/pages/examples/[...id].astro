---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';

export async function getStaticPaths() {
  const examples = await getCollection('entries', ({ data }) => data.section === 'example' && !data.draft);
  return examples.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props { entry: CollectionEntry<'entries'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout entry={entry}><Content /></EntryLayout>