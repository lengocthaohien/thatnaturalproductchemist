---
import type { CollectionEntry } from 'astro:content';
import NMRiumViewer from '../components/NMRiumViewer';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'entries'>;
}

const { entry } = Astro.props;
const { data } = entry;
const published = data.publishedAt.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
const updated = data.updatedAt?.toLocaleDateString('en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
});
---

<BaseLayout title={`${data.title} | That Natural Product Chemist`} description={data.summary}>
  <article class="article-shell">
    <header class="article-header">
      <div class="article-kicker">
        <span>{data.format.replaceAll('-', ' ')}</span>
        <span>{published}</span>
      </div>
      <h1>{data.title}</h1>
      <p class="article-summary">{data.summary}</p>
      <dl class="article-meta">
        <div>
          <dt>Author</dt>
          <dd>{data.author.name} <a href={`https://orcid.org/${data.author.orcid}`} rel="author external">ORCID</a></dd>
        </div>
        <div><dt>For</dt><dd>{data.audience.join(' · ')}</dd></div>
        {data.exercise && <div><dt>Solution</dt><dd>{data.exercise.solutionStatus.replace('-', ' ')}</dd></div>}
        {updated && <div><dt>Updated</dt><dd>{updated}</dd></div>}
      </dl>
    </header>

    {data.correctionNote && <aside class="correction-note"><strong>Correction:</strong> {data.correctionNote}</aside>}

    {data.spectrum && (
      <NMRiumViewer
        archiveUrl={data.spectrum.archiveUrl}
        downloadUrl={data.spectrum.downloadUrl}
        title={data.spectrum.viewerTitle}
        description={data.spectrum.viewerDescription}
        client:load
      />
    )}

    <div class="article-body"><slot /></div>

    <footer class="article-footer">
      {data.references.length > 0 && (
        <section aria-labelledby="references-title">
          <h2 id="references-title">References</h2>
          <ol>{data.references.map((reference) => <li>{reference.url ? <a href={reference.url}>{reference.citation}</a> : reference.citation}</li>)}</ol>
        </section>
      )}
      <p><strong>Suggested citation:</strong> {data.author.name}. “{data.title}.” <em>That Natural Product Chemist</em>, {published}.</p>
      <p>Original content is licensed under {data.license}.</p>
    </footer>
  </article>
</BaseLayout>